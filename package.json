{
  "name": "director",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm -r --if-present run dev:prepare",
    "dev": "pnpm --filter @directorkit/playground dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter @directorkit/playground test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish --no-git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10"
  }
}
