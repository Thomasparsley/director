# The @directorkit scope publishes to the public npm registry — registry.npmjs.org, npm's
# default, so no scope line is needed here (ADR-0020). What makes a publish public is
# `publishConfig.access: "public"` in each package. Add a `@directorkit:registry=` line
# only to override that default.

# Nuxt + pnpm: Nuxt's module / auto-import resolution expects a flat-ish node_modules.
# Hoist broadly to avoid "cannot resolve module" issues. Narrow later with public-hoist-pattern if desired.
shamefully-hoist=true
