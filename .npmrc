# Publish target for the @director scope (GitHub Packages — adjust if you use another registry)
@director:registry=https://npm.pkg.github.com

# Nuxt + pnpm: Nuxt's module / auto-import resolution expects a flat-ish node_modules.
# Hoist broadly to avoid "cannot resolve module" issues. Narrow later with public-hoist-pattern if desired.
shamefully-hoist=true
