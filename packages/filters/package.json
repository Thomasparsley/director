    "test:watch": "vitest"
  },
  "dependencies": {
    "@director/common": "workspace:*",
    "@director/forms": "workspace:*",
    "@vueuse/core": "14.3.0"
  },
  "peerDependencies": {
    "nuxt": "^4",
    "vue": "^3.5",
    "vue-router": "^5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "nuxt": "4.4.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue": "3.5.35",
    "vue-router": "5.1.0",
    "vue-tsc": "3.3.3"
  }
}
