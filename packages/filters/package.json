{
  "name": "@director/filters",
  "version": "0.0.0",
  "description": "URL-persisted page filter state for Nuxt, built on @director/forms. A Nuxt layer with no components.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "vue",
    "filters",
    "query-params",
    "forms",
    "director"
  ],
  "homepage": "https://github.com/Thomasparsley/director/tree/main/packages/filters#readme",
  "bugs": "https://github.com/Thomasparsley/director/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomasparsley/director.git",
    "directory": "packages/filters"
  },
  "license": "MIT",
  "author": "Tomáš Petržela <info@thomasparsley.cz>",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts",
    "!app/**/*.spec.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
