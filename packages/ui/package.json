{
  "name": "@director/ui",
  "version": "0.0.0",
  "description": "Component kit and design tokens for Nuxt — auto-registered <D*> components on reka-ui, with the palette living in the UnoCSS theme.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "vue",
    "ui",
    "components",
    "design-system",
    "unocss",
    "reka-ui",
    "director"
  ],
  "homepage": "https://github.com/Thomasparsley/director/tree/main/packages/ui#readme",
  "bugs": "https://github.com/Thomasparsley/director/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomasparsley/director.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "Tomáš Petržela <info@thomasparsley.cz>",
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": "./nuxt.config.ts",
    "./uno.config": "./uno.config.ts"
  },
  "files": [
    "app",
    "nuxt.config.ts",
    "uno.config.ts",
    "uno.colors.ts",
    "!app/**/*.spec.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@director/common": "workspace:*",
    "@internationalized/date": "3.12.2",
    "@nuxtjs/color-mode": "4.0.0",
    "@unocss/nuxt": "66.7.4",
    "@unocss/transformer-compile-class": "66.7.4",
    "@unocss/transformer-variant-group": "66.7.4",
    "class-variance-authority": "0.7.1",
    "nuxt-lucide-icons": "2.1.0",
    "reka-ui": "2.9.8",
    "unocss": "66.7.4",
    "vaul-vue": "0.4.1"
  },
  "peerDependencies": {
    "nuxt": "^4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue": "3.5.35",
    "vue-tsc": "3.3.3"
  }
}
