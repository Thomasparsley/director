{
  "name": "@director/common",
  "version": "0.0.0",
  "description": "Shared logic for the @director layer chain — utils, composables and types. A Nuxt layer with no components.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "vue",
    "composables",
    "director"
  ],
  "homepage": "https://github.com/Thomasparsley/director/tree/main/packages/common#readme",
  "bugs": "https://github.com/Thomasparsley/director/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomasparsley/director.git",
    "directory": "packages/common"
  },
  "license": "MIT",
  "author": "Tomáš Petržela <info@thomasparsley.cz>",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts",
    "!app/**/*.spec.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vueuse/core": "14.3.0"
  },
  "peerDependencies": {
    "nuxt": "^4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "3.3.3"
  }
}
