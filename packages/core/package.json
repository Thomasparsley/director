{
  "name": "@directorkit/core",
  "version": "0.1.2",
  "description": "Administration building blocks for Nuxt — app shell, navigation and CRUD scaffolds built on @directorkit/ui.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "vue",
    "admin",
    "dashboard",
    "app-shell",
    "director"
  ],
  "homepage": "https://github.com/Thomasparsley/director/tree/main/packages/core#readme",
  "bugs": "https://github.com/Thomasparsley/director/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomasparsley/director.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Tomáš Petržela <info@thomasparsley.cz>",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts",
    "!app/**/*.spec.ts"
  ],
  "publishConfig": {
    "access": "public",
