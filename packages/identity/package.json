{
  "name": "@directorkit/identity",
  "version": "0.1.0",
  "description": "Session/auth state for Nuxt behind an app-supplied IdentityApi — session machine, token lifecycle, keep-alive. No components.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "vue",
    "auth",
    "authentication",
    "session",
    "identity",
    "director"
  ],
  "homepage": "https://github.com/Thomasparsley/director/tree/main/packages/identity#readme",
  "bugs": "https://github.com/Thomasparsley/director/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thomasparsley/director.git",
    "directory": "packages/identity"
  },
  "license": "MIT",
  "author": "Tomáš Petržela <info@thomasparsley.cz>",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "transports",
    "nuxt.config.ts",
    "!app/**/*.spec.ts",
    "!transports/**/*.spec.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@directorkit/common": "workspace:*",
    "@vueuse/core": "14.3.0"
  },
  "peerDependencies": {
    "@simplewebauthn/browser": "^13",
    "nuxt": "^4",
    "vue": "^3.5"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@types/node": "^22",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "nuxt": "4.4.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue": "3.5.35",
    "vue-tsc": "3.3.3"
  },
  "peerDependenciesMeta": {
    "@simplewebauthn/browser": {
      "optional": true
    }
  }
}
